---
const specialties = [
  'Software a medida',
  'Automatización',
  'Productos digitales',
  'Integraciones',
  'Experiencias web',
];
---

<section class="hero-showcase" aria-labelledby="hero-title" data-hero>
  <div class="hero-orbit hero-orbit-left" aria-hidden="true">EST. 2026</div>
  <div class="hero-orbit hero-orbit-right" aria-hidden="true">CHACO / WORLDWIDE</div>

  <div class="hero-stage">
    <div class="hero-brand" data-hero-brand aria-hidden="true">
      {'NEADEV'.split('').map((letter) => (
        <span class="hero-brand-letter" data-hero-brand-letter>{letter}</span>
      ))}
    </div>

    <div class="hero-message" data-hero-message>
      <p class="hero-eyebrow" data-hero-detail>
        <span>NEADEV</span>
        <span class="hero-eyebrow-line" aria-hidden="true"></span>
        <span>SISTEMAS DIGITALES / 01</span>
      </p>

      <h1 id="hero-title" class="hero-heading" data-i18n-html="hero.title">
        Construimos lo que tu negocio necesita.
        <span class="text-primary-500">No lo que está de moda.</span>
      </h1>

      <p class="hero-description" data-hero-detail data-i18n-html="hero.subtitle">
        <span class="text-primary-500">Automatización</span>, <span class="text-primary-500">integración</span>, <span class="text-primary-500">digitalización</span>.
        Analizamos dónde se frena tu operación, ordenamos el problema y construimos una solución que tu equipo pueda usar y mantener.
      </p>

      <div class="hero-actions" data-hero-detail>
        <a data-magnetic href="#contact" class="hero-primary-action">
          <span data-i18n="hero.cta">Empezar un proyecto</span>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M3 9h12M10 4l5 5-5 5" />
          </svg>
        </a>
        <a data-magnetic href="#services" class="hero-secondary-action">
          <span data-i18n="hero.secundario">Ver qué hacemos</span>
        </a>
      </div>
    </div>
  </div>

  <div class="hero-marquee" data-hero-marquee role="img" aria-label="Especialidades: software a medida, automatización, productos digitales, integraciones y experiencias web">
    <div class="hero-marquee-track" aria-hidden="true">
      {[0, 1].map((group) => (
        <div class="hero-marquee-group" data-marquee-group={group}>
          {specialties.map((specialty) => (
            <span class="hero-marquee-item">
              <span>{specialty}</span>
              <span class="hero-marquee-symbol">✦</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
