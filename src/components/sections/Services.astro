---
const services = [
  {
    title: 'Automatización e IA',
    description: 'Automatizamos tareas repetitivas y creamos asistentes que alivian el trabajo diario de tu equipo.',
    paths: ['M8 9h8M8 13h5', 'M9 3h6l1 3h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h2l1-3Z', 'M9 19v2m6-2v2'],
  },
  {
    title: 'Software y plataformas',
    description: 'Diseñamos productos digitales y software a medida preparados para crecer con tu operación.',
    paths: ['M4 5h16v11H4z', 'M9 20h6M12 16v4', 'm8 9-3 3 3 3m8-6 3 3-3 3'],
  },
  {
    title: 'Integraciones y estrategia',
    description: 'Conectamos tus herramientas y definimos qué conviene construir antes de invertir tiempo y recursos.',
    paths: ['M7 7h10v10H7z', 'M3 3h5v5H3zM16 16h5v5h-5z', 'M8 5h5a4 4 0 0 1 4 4v7'],
  },
];
---

<section id="services" class="services-section" aria-labelledby="services-title">
  <div class="services-shell reveal-fade-up" data-reveal>
    <header class="services-heading">
      <h2 id="services-title" class="services-title">
        Impulsamos ideas que
        <span>hacen la diferencia.</span>
      </h2>

      <p class="services-intro">
        Tres formas concretas de convertir problemas operativos en soluciones que tu equipo pueda usar de verdad.
      </p>
    </header>

    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card">
          <span class="service-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              {service.paths.map((path) => <path d={path} />)}
            </svg>
          </span>

          <div class="service-card-copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
