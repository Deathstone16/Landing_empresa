---
const steps = [
  {
    number: '01',
    title: 'Diagnóstico',
    description: 'Entendemos el problema, el contexto y el resultado que necesitás.',
  },
  {
    number: '02',
    title: 'Propuesta',
    description: 'Definimos una solución clara, priorizada y lista para validar.',
  },
  {
    number: '03',
    title: 'Desarrollo',
    description: 'Construimos por etapas y compartimos avances concretos.',
  },
  {
    number: '04',
    title: 'Acompañamiento',
    description: 'Lanzamos, medimos y mejoramos la solución junto a tu equipo.',
  },
];
---

<section id="process" class="process-section" aria-labelledby="process-title">
  <div class="process-shell reveal-fade-up" data-reveal>
    <header class="process-heading">
      <h2 id="process-title" class="process-title">
        Nos enfocamos estratégicamente <span>en cada paso.</span>
      </h2>
    </header>

    <div class="process-track-wrap">
      <span class="process-line" aria-hidden="true"></span>
      <ol class="process-track">
        {steps.map((step) => (
          <li class="process-step">
            <span class="process-number">{step.number}</span>
            <div class="process-card-copy">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
