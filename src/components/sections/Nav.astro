---
import BrandMark from '../ui/BrandMark.astro';

const navLinks = [
  { label: 'Servicios', href: '#services', i18n: 'nav.servicios' },
  { label: 'Proceso', href: '#process', i18n: 'nav.proceso' },
  { label: 'Contacto', href: '#contact', i18n: 'nav.contacto' },
];
---

<header class="site-nav" id="nav" data-nav>
  <nav class="nav-shell" aria-label="Principal">
    <a href="/" class="nav-brand" aria-label="Neadev — Inicio">
      <BrandMark class="nav-brand-mark" />
      <span class="nav-brand-name">NEADEV</span>
    </a>

    <div class="nav-desktop">
      <div class="nav-links">
        {navLinks.map((link) => (
          <a href={link.href} class="nav-link" data-i18n={link.i18n}>
            {link.label}
          </a>
        ))}
      </div>

      <div class="nav-actions">
        <button id="theme-toggle" class="nav-icon-button" type="button" aria-label="Cambiar modo claro" title="Cambiar tema">
          <svg class="block light:hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
          </svg>
          <svg class="hidden light:block" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.5 13.2A8.5 8.5 0 1 1 10.8 3.5a6.5 6.5 0 0 0 9.7 9.7Z" />
          </svg>
        </button>
        <button id="lang-toggle" class="nav-language" type="button" data-i18n="lang.toggle" aria-label="Cambiar idioma">EN</button>
        <a href="#contact" class="nav-cta" data-i18n="nav.empezar">Hablemos</a>
      </div>
    </div>

    <button class="nav-menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span></span>
      <span></span>
    </button>
  </nav>

  <div id="mobile-backdrop" data-mobile-backdrop aria-hidden="true"></div>

  <div id="mobile-menu" data-mobile-menu style="display: none;" aria-hidden="true">
    <div class="mobile-menu-header">
      <span class="mobile-menu-label">Navegación / 01</span>
      <button class="mobile-menu-close" type="button" aria-label="Cerrar menú" data-menu-close>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="mobile-menu-links" aria-label="Navegación móvil">
      {navLinks.map((link, index) => (
        <a href={link.href} class="mobile-nav-link" style={`--i: ${index}`}>
          <span class="mobile-nav-index">0{index + 1}</span>
          <span data-i18n={link.i18n}>{link.label}</span>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
            <path d="M4 10h12M11 5l5 5-5 5" />
          </svg>
        </a>
      ))}
    </nav>

    <div class="mobile-menu-footer">
      <div class="mobile-menu-settings">
        <button id="theme-toggle-mobile" class="mobile-setting" type="button" aria-label="Cambiar modo claro">Cambiar tema</button>
        <button id="lang-toggle-mobile" class="mobile-setting" type="button" data-i18n="lang.toggle" aria-label="Cambiar idioma">EN</button>
      </div>
      <a href="#contact" class="mobile-cta" data-i18n="nav.empezar">Hablemos</a>
      <a href="mailto:neadevar@gmail.com" class="mobile-menu-email">neadevar@gmail.com</a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const backdrop = document.querySelector<HTMLElement>('[data-mobile-backdrop]');
  let previousOverflow = '';

  const updateNav = () => {
    nav?.classList.toggle('is-scrolled', window.scrollY > 24);
  };

  window.addEventListener('scroll', updateNav, { passive: true });
  updateNav();

  function openMobileMenu() {
    if (!menu || !backdrop || !toggle) return;
    previousOverflow = document.body.style.overflow;
    backdrop.style.display = 'block';
    menu.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    menu.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Cerrar menú');
    requestAnimationFrame(() => requestAnimationFrame(() => {
      backdrop.classList.add('open');
      menu.classList.add('open');
    }));
  }

  function closeMobileMenu({ restoreFocus = false } = {}) {
    if (!menu || !backdrop || !toggle) return;
    backdrop.classList.remove('open');
    menu.classList.remove('open');
    menu.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Abrir menú');
    document.body.style.overflow = previousOverflow;
    window.setTimeout(() => {
      if (!menu.classList.contains('open')) {
        menu.style.display = 'none';
        backdrop.style.display = 'none';
      }
    }, 420);
    if (restoreFocus) toggle.focus();
  }

  toggle?.addEventListener('click', () => {
    if (toggle.getAttribute('aria-expanded') === 'true') closeMobileMenu();
    else openMobileMenu();
  });

  closeButton?.addEventListener('click', () => closeMobileMenu({ restoreFocus: true }));
  backdrop?.addEventListener('click', () => closeMobileMenu());
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMobileMenu()));

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMobileMenu({ restoreFocus: true });
    }
  });

  function toggleTheme() {
    const isLight = document.documentElement.classList.toggle('light');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
  }

  document.querySelectorAll('#theme-toggle, #theme-toggle-mobile').forEach((button) => {
    button.addEventListener('click', toggleTheme);
  });

  document.querySelectorAll('#lang-toggle, #lang-toggle-mobile').forEach((button) => {
    button.addEventListener('click', () => window.__toggleLang?.());
  });
</script>
